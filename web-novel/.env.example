# Use a unique password of at least 12 characters.
APP_PASSWORD=
PAGEKIN_BIND=127.0.0.1
PAGEKIN_PORT=3100
# Keep this value during upgrades. Use a different empty volume for restore.
PAGEKIN_VOLUME=web-novel_novels
# Public browser URL when using a reverse proxy. Example: https://novel.example.net
APP_ORIGIN=
APP_SECURE_COOKIE=1
# Optional OpenAI-compatible streaming model. Leave LLM_MODEL blank for manual writing.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_CONTEXT_CHARS=64000
