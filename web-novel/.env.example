# Use a unique password of at least 12 characters.
APP_PASSWORD=
PAGEKIN_BIND=127.0.0.1
PAGEKIN_PORT=3100
# Keep this value during upgrades. Use a different empty volume for restore.
PAGEKIN_VOLUME=web-novel_novels
# Public browser URL when using a reverse proxy. Example: https://novel.example.net
APP_ORIGIN=
APP_SECURE_COOKIE=1
# Set to plain to use the basic editor on all devices.
APP_EDITOR=auto
# Optional OpenAI-compatible streaming model. Leave LLM_MODEL blank for manual writing.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_CONTEXT_CHARS=64000
# Optional catalog of writing models. Use one JSON source.
# LLM_PROFILES_JSON='[{"id":"local","label":"本地模型","baseUrl":"http://model:11434/v1","model":"my-model","contextChars":48000}]'
# LLM_PROFILES_FILE=/run/pagekin/model-profiles.json
# Optional reference indexing via an OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
